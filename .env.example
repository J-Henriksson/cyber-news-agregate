# Gemini reads the news for names, roles and amounts. Without a key the
# rules alone read it (known names only).
GEMINI_API_KEY=
# RADAR_LLM_MODEL=gemini-3.5-flash-lite
# RADAR_LLM_DAILY_CALLS=60
# RADAR_LLM_BATCH=20

# A read-only copy of the page on GitHub Pages, pushed from this machine while
# the app runs. Name a remote of this repository (or an address) to turn it on.
# RADAR_PAGES=origin
# Minutes between copies (0: only the one after a start).
# RADAR_PAGES_EVERY_MIN=60
# Words the copy must never hold, comma-separated: an incident that writes one
# is left out of it.
# RADAR_PAGES_WITHHOLD=
